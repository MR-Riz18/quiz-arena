# QuizArena — server environment (copy to `.env`, never commit the real one)
# Server defaults: PORT 5001, client dev server http://localhost:5173.

# MongoDB connection string (required — server exits without it)
MONGO_URI=mongodb://localhost:27017/quizarena

# Secret used to sign the 8h JWT cookie (required — generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime (optional, default 8h)
JWT_EXPIRE=8h

# Port the API + Socket.IO server listens on (optional, default 5001)
PORT=5001

# Allowed browser origin for CORS + Socket.IO (optional, default http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Seconds a disconnected player has to reconnect before forfeiting (optional, default 60000)
RECONNECT_GRACE_MS=60000
